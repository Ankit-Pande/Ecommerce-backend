# development | production (khaali chhoda to production maana jaayega)
NODE_ENV=development
PORT=8000
LOG_LEVEL=debug
# Railway jaise ek proxy ke peeche 1. Aage Cloudflare ho to 2.
TRUST_PROXY_HOPS=1
# Poore /api par ek IP ki per-minute limit.
API_RATE_MAX=300

DATABASE_URL="postgresql://user:pass@host:5432/dbname"
DIRECT_URL="postgresql://user:pass@host:5432/dbname"
REDIS_URL="redis://localhost:6379"

# Comma se alag. Production me localhost nahi chalega.
FRONTEND_ORIGINS="http://localhost:3000"
# Is number se OTP login karte hi account SUPER_ADMIN ban jaata hai.
SUPER_ADMIN_PHONE="9876543210"

# openssl rand -hex 32 — teeno alag
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
OTP_SECRET=""
JWT_ACCESS_EXPIRY="15m"

MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_OTP_TEMPLATE_ID=""
# Poore din me kitne OTP SMS — MSG91 ka bill isi se bandha hai.
DAILY_SMS_CAP=2000

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Online order itne minute me pay na ho to cancel + stock wapas.
PAYMENT_WINDOW_MINUTES=30
# Ek user ke ek saath kitne unpaid online (ya abhi ship na hue COD) order.
MAX_PENDING_ORDERS=2
