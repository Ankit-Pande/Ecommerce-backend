NODE_ENV=development
PORT=8000
LOG_LEVEL=debug
# Railway: 1, Railway + Cloudflare: 2
TRUST_PROXY_HOPS=1
API_RATE_MAX=300

DATABASE_URL="postgresql://user:pass@host:5432/dbname"
DIRECT_URL="postgresql://user:pass@host:5432/dbname"
REDIS_URL="redis://localhost:6379"

# Comma separated. localhost is not allowed in production.
FRONTEND_ORIGINS="http://localhost:3000"
SUPER_ADMIN_PHONE="9876543210"

# openssl rand -hex 32 (three different values)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
OTP_SECRET=""

MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_OTP_TEMPLATE_ID=""
DAILY_SMS_CAP=2000

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Empty key = assistant uses only instant (DB) search
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-3.1-flash-lite"
GEMINI_EMBED_MODEL="gemini-embedding-001"
AI_DAILY_LIMIT=1000
