datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // pg_trgm: galat spelling wali search; vector: AI ki meaning wali search.
  extensions = [pg_trgm, vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

// REFUNDED: admin ne Razorpay se paisa lauta diya.
enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE
}

// Order kisne cancel kiya: customer, admin ya system (payment time par nahi aaya).
enum CancelledBy {
  USER
  ADMIN
  SYSTEM
}

model User {
  id             String  @id @default(uuid())
  phone          String  @unique
  alternatePhone String?
  name           String?
  email          String? @unique
  role           Role    @default(USER)
  isBlocked      Boolean @default(false)
  isDeleted      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  addresses Address[]
  cart      Cart?
  orders    Order[]
  reviews   Review[]
}

// Ek row = ek device ka login.
model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti         String    @unique
  // Pichhla token id: do tab ek saath refresh karein to 1 minute tak ye bhi chalega.
  previousJti String?
  rotatedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

// Category aur subcategory ek hi table me (2 level).
model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  image    String?
  parentId String?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("SubCategories")
  isActive Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([parentId, isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Brand {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  logo     String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Product {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  description String

  // Paise me (Rs.499 = 49900). sellPaise = discount ke baad ka price, filter aur sort isi par.
  pricePaise      Int
  discountPercent Int       @default(0)
  sellPaise       Int
  offerEndsAt     DateTime?

  stock    Int      @default(0)
  color    String?
  gender   String?
  ageGroup String?
  images   String[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id])

  isActive   Boolean @default(true)
  isTrending Boolean @default(false)
  isFeatured Boolean @default(false)

  // Rating ka hisaab yahin rakhte hain, taaki har baar saare reviews na ginne padein.
  ratingSum     Int   @default(0)
  ratingCount   Int   @default(0)
  ratingAverage Float @default(0)

  // AI search ka data (Gemini embedding). Naye "migrate dev" me "DROP INDEX Product_embedding_idx" aaye to wo line hata dena.
  embedding Unsupported("halfvec(768)")?

  // AI search ke liye naam aur rang ke shabd (DB khud banata hai, full-text index ke saath).
  searchText Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((COALESCE(name, ''::text) || ' '::text) || COALESCE(color, ''::text)))"))

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId, isActive])
  @@index([brandId, isActive])
  @@index([isActive, createdAt])
  @@index([isActive, sellPaise])
  @@index([isActive, discountPercent])
  @@index([isActive, ratingAverage])
  @@index([isActive, isTrending])
  @@index([isActive, isFeatured])
  @@index([discountPercent, offerEndsAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([color(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([searchText], type: Gin)
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

// Stock order banne par katta hai aur sirf cancel hone par wapas aata hai.
model Order {
  id             String @id @default(uuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id])
  idempotencyKey String

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  // Delivery ka pata order me copy hota hai, taaki address badle to order ka pata na badle.
  shipName    String
  shipPhone   String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipPincode String

  totalPaise    Int
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod

  // Online order: is time tak payment na aaye to order cancel aur stock wapas.
  paymentExpiresAt  DateTime?
  razorpayOrderId   String?      @unique
  razorpayPaymentId String?
  // Payment aayi par order confirm nahi ho saka (late ya galat amount), admin dekhe.
  needsReview       Boolean      @default(false)
  cancelledBy       CancelledBy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([addressId])
  @@index([createdAt])
  @@index([status, paymentExpiresAt])
  @@index([needsReview, createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Order ke time ka naam, photo aur price.
  productName  String
  productImage String?
  pricePaise   Int
  quantity     Int

  @@index([orderId])
  @@index([productId])
}

// Razorpay ke message ki id, taaki ek payment do baar na gine.
model WebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

model Review {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

model Banner {
  id       String  @id @default(uuid())
  image    String
  link     String?
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}
