datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm, vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum CancelledBy {
  USER
  ADMIN
  SYSTEM
}

model User {
  id        String  @id @default(uuid())
  phone     String  @unique
  name      String?
  email     String? @unique
  role      Role    @default(USER)
  isBlocked Boolean @default(false)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  addresses Address[]
  cart      Cart?
  orders    Order[]
  reviews   Review[]
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti         String    @unique
  previousJti String?
  rotatedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  image    String?
  parentId String?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("SubCategories")
  isActive Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([parentId, isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Brand {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  logo     String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Product {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  description String

  pricePaise      Int
  discountPercent Int       @default(0)
  sellPaise       Int
  offerEndsAt     DateTime?

  stock    Int      @default(0)
  colors   String[] @default([])
  sizes    String[] @default([])
  gender   String?
  ageGroup String?
  images   String[]
  specs    Json?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id])

  isActive   Boolean @default(true)
  isTrending Boolean @default(false)
  isFeatured Boolean @default(false)

  ratingSum     Int   @default(0)
  ratingCount   Int   @default(0)
  ratingAverage Float @default(0)

  embedding       Unsupported("halfvec(768)")?
  searchText      Unsupported("tsvector")?     @default(dbgenerated("to_tsvector('english'::regconfig, ((COALESCE(name, ''::text) || ' '::text) || COALESCE((specs)::text, ''::text)))"))
  descriptionText Unsupported("tsvector")?     @default(dbgenerated("to_tsvector('english'::regconfig, description)"))

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId, isActive])
  @@index([brandId, isActive])
  @@index([isActive, createdAt])
  @@index([isActive, sellPaise])
  @@index([isActive, discountPercent])
  @@index([isActive, ratingAverage])
  @@index([isActive, isTrending])
  @@index([isActive, isFeatured])
  @@index([discountPercent, offerEndsAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([colors], type: Gin)
  @@index([searchText], type: Gin)
  @@index([descriptionText], type: Gin)
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  size      String  @default("")
  color     String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId, size, color])
}

model Order {
  id             String @id @default(uuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id])
  idempotencyKey String

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  shipName    String
  shipPhone   String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipPincode String

  totalPaise    Int
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod

  paymentExpiresAt  DateTime?
  razorpayOrderId   String?      @unique
  razorpayPaymentId String?
  needsReview       Boolean      @default(false)
  cancelledBy       CancelledBy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([addressId])
  @@index([createdAt])
  @@index([status, paymentExpiresAt])
  @@index([needsReview, createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  productName  String
  productImage String?
  pricePaise   Int
  quantity     Int
  size         String?
  color        String?

  @@index([orderId])
  @@index([productId])
}

model WebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

model Review {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

model Banner {
  id       String  @id @default(uuid())
  image    String
  link     String?
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}
